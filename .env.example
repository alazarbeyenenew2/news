# Local development only. In production every value below is set in GitHub
# (Settings -> Secrets and variables -> Actions) and the deploy workflow writes .env on the server.

# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Name used in the bot's messages
BOT_NAME=NewsPulse

# Your Telegram user ID(s), comma separated. Always admin; get your ID from @userinfobot.
SUPER_ADMIN_IDS=123456789

# Web admin page login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign login cookies: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-string

# Times shown to users (publication time, digest hour) and the meaning of "today"
TIMEZONE=Africa/Addis_Ababa

# PostgreSQL. With docker compose the database is created with this user and password the first time.
# Running main.py directly: point POSTGRES_HOST / POSTGRES_PORT at your own PostgreSQL.
POSTGRES_USER=newsbot
POSTGRES_PASSWORD=choose-a-strong-database-password
POSTGRES_DB=newsbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- News collection (all optional; defaults shown) ---
# COLLECTOR_ENABLED=true
# DELIVERY_ENABLED=true
# FETCH_TIMEOUT_SECONDS=20
# FETCH_MAX_BYTES=5242880
# FETCH_CONCURRENCY=4
# USER_AGENT=NewsPulseBot/1.0 (RSS reader; links to original articles)
# Articles older than this when first seen are stored but never alerted
# MAX_ARTICLE_AGE_HOURS=12
# Minimum confidence (0..1) for an article to count for a topic
# CLASSIFY_MIN_CONFIDENCE=0.6
# DEDUP_WINDOW_HOURS=48
# DEDUP_TITLE_SIMILARITY=0.88
# Articles (and their alert history) are deleted after this many days; 0 = keep forever
# ARTICLE_RETENTION_DAYS=30

# --- CVE reports (optional) ---
# NIST NVD API key: raises NVD's limit from 5 to 50 requests per 30 s. https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# --- Delivery (optional) ---
# MESSAGES_PER_SECOND=20
# MAX_SEND_ATTEMPTS=5
# Daily alert limit for new users (0 = no limit); users can change theirs
# DEFAULT_MAX_PER_DAY=30
# DIGEST_MAX_ARTICLES=15

# --- Docker Compose only ---
# Domain for the HTTPS admin page (used with: docker compose --profile https up -d)
DOMAIN=admin.example.com
# Port the admin page is published on, on all of the server's interfaces (0.0.0.0)
ADMIN_PORT=8000
